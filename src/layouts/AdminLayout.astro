---
const { title = 'HOA Admin' } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} | Barrier Dunes</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700&family=Playfair+Display:wght@400;600&display=swap" rel="stylesheet">
  </head>
  <body class="min-h-screen bg-beach-sky/10 text-beach-slate">
    <header class="border-b border-beach-sky/30 bg-white">
      <div class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-4 py-4 sm:px-6 lg:px-8">
        <div>
          <a href={base} class="font-serif text-xl uppercase tracking-widest text-beach-slate">Barrier Dunes</a>
          <p class="mt-1 text-[10px] font-sans uppercase tracking-[.25em] text-beach-slate/55">Board administration</p>
        </div>
        <a href={base} class="min-h-11 border border-beach-slate/30 px-4 py-3 text-[10px] font-sans uppercase tracking-[.22em] hover:border-beach-slate">Public site</a>
      </div>
    </header>
    <main><slot /></main>
  </body>
</html>
