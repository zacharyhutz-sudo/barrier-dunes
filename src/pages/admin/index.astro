---
import AdminLayout from '../../layouts/AdminLayout.astro';
---

<AdminLayout title="Property Overview">
  <section class="px-3 py-5 sm:px-6 lg:px-8 lg:py-7">
    <div class="mx-auto max-w-[1780px]">
      <header class="mb-5 flex flex-col gap-4 border border-beach-sky/40 bg-white px-5 py-5 shadow-sm sm:px-6 lg:flex-row lg:items-center lg:justify-between">
        <div>
          <span class="admin-kicker">Barrier Dunes HOA</span>
          <h1 class="mt-2 font-serif text-3xl text-beach-slate sm:text-4xl">Property Overview</h1>
          <p class="mt-2 max-w-2xl text-sm leading-relaxed text-beach-slate/65">
            A simple view of condo condition, maintenance dates, and property notes.
          </p>
        </div>
        <div class="flex flex-wrap items-center gap-3 lg:justify-end">
          <div class="min-w-0 text-sm leading-relaxed text-beach-slate/65">
            <strong data-profile-name class="block truncate font-semibold text-beach-slate"></strong>
            <span data-profile-role class="text-[11px] uppercase tracking-[.12em]"></span>
          </div>
          <button data-export type="button" class="admin-button-secondary">Export</button>
          <button data-sign-out type="button" class="admin-button-secondary">Sign Out</button>
        </div>
      </header>

      <div data-admin-loading class="border border-beach-sky/40 bg-white p-8 text-sm text-beach-slate/70 shadow-sm">
        Loading property records…
      </div>

      <div data-access-denied class="hidden border border-red-200 bg-white p-8 text-red-700 shadow-sm">
        <p class="font-semibold">This account does not currently have access to the Barrier Dunes administration area.</p>
        <p class="mt-2 text-sm">Please contact the site administrator for assistance.</p>
      </div>

      <div data-admin-dashboard class="hidden space-y-4">
        <div data-admin-message class="fixed bottom-4 left-4 right-4 z-[1500] hidden rounded-sm border bg-white p-4 text-sm shadow-xl md:left-auto md:max-w-md" aria-live="polite"></div>

        <section class="admin-summary-strip" aria-label="Property summary">
          <button data-quick-filter="all" type="button" class="admin-summary-link is-active">
            <span data-summary-total class="admin-summary-number">0</span>
            <span class="admin-summary-label">Condos</span>
          </button>
          <button data-quick-filter="attention" type="button" class="admin-summary-link">
            <span data-summary-attention class="admin-summary-number">0</span>
            <span class="admin-summary-label">Need attention</span>
          </button>
          <button data-quick-filter="monitor" type="button" class="admin-summary-link">
            <span data-summary-monitor class="admin-summary-number">0</span>
            <span class="admin-summary-label">Monitor</span>
          </button>
          <button data-quick-filter="paint" type="button" class="admin-summary-link" data-paint-summary>
            <span data-summary-paint class="admin-summary-number">0</span>
            <span class="admin-summary-label">Need paint</span>
          </button>
        </section>

        <nav class="admin-view-tabs" aria-label="Admin views">
          <button data-view-tab="properties" type="button" class="admin-view-tab is-active">Properties</button>
          <button data-view-tab="map" type="button" class="admin-view-tab">Map</button>
        </nav>

        <section data-view-panel="properties" class="space-y-3">
          <div class="admin-toolbar">
            <label class="admin-search-wrap">
              <span class="sr-only">Search condos</span>
              <svg aria-hidden="true" viewBox="0 0 24 24" class="h-5 w-5"><path d="m21 21-4.35-4.35m2.35-5.15A7.5 7.5 0 1 1 4 11.5a7.5 7.5 0 0 1 15 0Z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
              <input data-search type="search" placeholder="Search condo, owner, or building" class="admin-search" />
            </label>

            <div class="admin-filter-group">
              <label>
                <span class="sr-only">Category filter</span>
                <select data-category-filter class="admin-compact-select">
                  <option value="all">Any category</option>
                </select>
              </label>
              <label>
                <span class="sr-only">Condition filter</span>
                <select data-condition-filter class="admin-compact-select">
                  <option value="all">Any condition</option>
                  <option value="open">Needs attention</option>
                  <option value="monitor">Monitor</option>
                  <option value="complete">Good</option>
                  <option value="unknown">Not reviewed</option>
                  <option value="not_applicable">N/A</option>
                </select>
              </label>
              <label>
                <span class="sr-only">Sort condos</span>
                <select data-sort class="admin-compact-select">
                  <option value="unit-asc">Condo number</option>
                  <option value="attention">Needs attention first</option>
                  <option value="recent">Recently updated</option>
                </select>
              </label>
            </div>

            <button data-clear-filters type="button" class="admin-text-button">Clear filters</button>
            <button data-add-condo type="button" class="admin-button-primary hidden">+ Add Condo</button>
          </div>

          <div class="flex items-center justify-between gap-3 px-1 text-sm text-beach-slate/60">
            <p data-result-count></p>
            <p class="hidden sm:block">Click a condo or condition to edit.</p>
          </div>

          <div class="hidden overflow-x-auto border border-beach-sky/40 bg-white shadow-sm md:block">
            <table class="admin-table">
              <thead data-table-head></thead>
              <tbody data-table-body></tbody>
            </table>
          </div>

          <div data-mobile-list class="space-y-3 md:hidden"></div>

          <div data-empty-state class="hidden border border-dashed border-beach-sky bg-white p-10 text-center shadow-sm">
            <p class="font-serif text-2xl text-beach-slate">No condos match this view.</p>
            <button data-empty-clear type="button" class="admin-button-secondary mt-4">Clear filters</button>
          </div>
        </section>

        <section data-view-panel="map" class="hidden">
          <div class="relative overflow-hidden border border-beach-sky/40 bg-white shadow-sm">
            <div class="flex flex-col gap-3 border-b border-beach-sky/40 p-4 sm:flex-row sm:items-center sm:justify-between">
              <div>
                <h2 class="font-serif text-2xl text-beach-slate">Community Map</h2>
                <p class="mt-1 text-sm text-beach-slate/60">Click a condo marker to open its record.</p>
              </div>
              <button data-map-add-condo type="button" class="admin-button-primary hidden">+ Add Condo</button>
            </div>

            <div data-map-instruction class="hidden border-b border-beach-sea/40 bg-beach-sea/15 px-4 py-3 text-sm text-beach-slate">
              <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
                <p data-map-instruction-text class="font-medium"></p>
                <div class="flex items-center gap-3">
                  <button data-save-map-location type="button" class="admin-button-primary hidden">Save Location</button>
                  <button data-cancel-map-mode type="button" class="admin-text-button self-start sm:self-auto">Cancel</button>
                </div>
              </div>
            </div>

            <div id="admin-map" class="h-[66vh] min-h-[500px] w-full"></div>

            <form data-add-condo-card class="absolute bottom-4 left-4 right-4 z-[800] hidden max-w-md border border-beach-sky/60 bg-white p-5 shadow-2xl sm:right-auto">
              <span class="admin-kicker">New Condo</span>
              <h3 class="mt-2 font-serif text-2xl text-beach-slate">Save this map location</h3>
              <p class="mt-1 text-sm leading-relaxed text-beach-slate/60">Drag the pin if needed, then enter the condo number.</p>
              <div class="mt-4 grid gap-3 sm:grid-cols-2">
                <label class="sm:col-span-2">
                  <span class="admin-label">Condo number</span>
                  <input data-add-number class="admin-input" required placeholder="Example: 150" autocomplete="off" />
                </label>
                <label>
                  <span class="admin-label">Owner name</span>
                  <input data-add-owner class="admin-input" placeholder="Optional" />
                </label>
                <label>
                  <span class="admin-label">Building</span>
                  <input data-add-building class="admin-input" placeholder="Optional" />
                </label>
              </div>
              <p data-add-error class="mt-3 hidden text-sm text-red-700" role="alert"></p>
              <div class="mt-4 flex flex-col-reverse gap-2 sm:flex-row sm:justify-end">
                <button data-cancel-add-card type="button" class="admin-button-secondary">Cancel</button>
                <button data-save-add-condo type="submit" class="admin-button-primary">Add Condo</button>
              </div>
            </form>
          </div>
        </section>
      </div>
    </div>
  </section>

  <div data-drawer-backdrop class="fixed inset-0 z-[1050] hidden bg-beach-slate/35 backdrop-blur-[1px]"></div>
  <aside data-condo-drawer class="admin-drawer" aria-hidden="true">
    <form data-condo-form class="flex min-h-full flex-col">
      <div class="sticky top-0 z-10 border-b border-beach-sky/40 bg-white px-5 py-4 sm:px-6">
        <div class="flex items-start justify-between gap-4">
          <div class="min-w-0">
            <span class="admin-kicker">Condo Record</span>
            <h2 data-drawer-title class="mt-2 truncate font-serif text-3xl text-beach-slate">Unit</h2>
            <p data-drawer-subtitle class="mt-1 text-sm text-beach-slate/60"></p>
          </div>
          <button data-drawer-close type="button" class="admin-icon-button" aria-label="Close condo record">×</button>
        </div>
      </div>

      <div class="flex-1 space-y-7 overflow-y-auto px-5 py-6 sm:px-6">
        <section>
          <div class="mb-3 flex items-center justify-between gap-3">
            <h3 class="font-serif text-xl text-beach-slate">Property Details</h3>
            <button data-move-pin type="button" class="admin-text-button hidden">Move map pin</button>
          </div>
          <div class="grid gap-4 sm:grid-cols-2">
            <label>
              <span class="admin-label">Condo number</span>
              <input data-edit-number class="admin-input" />
            </label>
            <label>
              <span class="admin-label">Building</span>
              <input data-edit-building class="admin-input" />
            </label>
            <label class="sm:col-span-2">
              <span class="admin-label">Owner name</span>
              <input data-edit-owner class="admin-input" />
            </label>
            <label>
              <span class="admin-label">Owner email</span>
              <input data-edit-owner-email type="email" class="admin-input" />
            </label>
            <label>
              <span class="admin-label">Owner phone</span>
              <input data-edit-owner-phone type="tel" class="admin-input" />
            </label>
            <label class="sm:col-span-2">
              <span class="admin-label">General property notes</span>
              <textarea data-edit-notes rows="3" class="admin-input"></textarea>
            </label>
          </div>
        </section>

        <section>
          <div class="mb-4">
            <h3 class="font-serif text-xl text-beach-slate">Condition & Maintenance</h3>
            <p class="mt-1 text-sm leading-relaxed text-beach-slate/60">Choose the current condition and keep the most recent known work date. Dates stay on the record even if an item later needs attention again.</p>
          </div>
          <div data-drawer-items class="space-y-3"></div>
        </section>

        <section class="border-t border-beach-sky/40 pt-6">
          <details data-history-details>
            <summary class="flex min-h-11 cursor-pointer list-none items-center justify-between gap-3 font-serif text-xl text-beach-slate">
              <span>Maintenance History</span>
              <span class="font-sans text-sm text-beach-slate/50">View history</span>
            </summary>
            <div data-history-list class="mt-4 space-y-3"></div>
          </details>
        </section>
      </div>

      <div class="sticky bottom-0 border-t border-beach-sky/40 bg-white px-5 py-4 sm:px-6">
        <div class="flex flex-col-reverse gap-2 sm:flex-row sm:items-center sm:justify-between">
          <p data-drawer-save-status class="text-sm text-beach-slate/60"></p>
          <button data-save-condo type="submit" class="admin-button-primary">Save Changes</button>
        </div>
      </div>
    </form>
  </aside>
</AdminLayout>

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" crossorigin="" />
<script is:inline src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" crossorigin=""></script>
<script>import '../../scripts/adminDashboard.js';</script>

<style is:global>
  .admin-kicker{font-family:Montserrat,sans-serif;font-size:11px;font-weight:600;letter-spacing:.18em;text-transform:uppercase;color:#796d4c}
  .admin-label{display:block;margin-bottom:.45rem;font-family:Montserrat,sans-serif;font-size:11px;font-weight:600;letter-spacing:.11em;text-transform:uppercase;color:rgba(69,90,100,.72)}
  .admin-input{width:100%;min-height:46px;border:1px solid rgba(180,210,225,.88);background:#fff;padding:.72rem .9rem;font-family:Montserrat,sans-serif;font-size:.9rem;color:#455A64;outline:none;transition:.15s}.admin-input:focus{border-color:#3c7f81;box-shadow:0 0 0 3px rgba(60,127,129,.13)}.admin-input:disabled{background:#f8fafb;color:rgba(69,90,100,.62)}
  .admin-button-primary,.admin-button-secondary{display:inline-flex;min-height:44px;align-items:center;justify-content:center;padding:.68rem 1rem;font-family:Montserrat,sans-serif;font-size:11px;font-weight:700;letter-spacing:.11em;text-transform:uppercase;transition:.15s}.admin-button-primary{background:#455A64;color:#fff}.admin-button-primary:hover{background:#3c7f81}.admin-button-secondary{border:1px solid rgba(69,90,100,.35);background:#fff;color:#455A64}.admin-button-secondary:hover{border-color:#455A64;background:rgba(216,235,245,.22)}.admin-button-primary:disabled,.admin-button-secondary:disabled{cursor:not-allowed;opacity:.45}
  .admin-text-button{min-height:40px;padding:.35rem .25rem;font-size:.76rem;font-weight:700;color:#455A64;text-decoration:underline;text-decoration-color:#9AD9D9;text-underline-offset:4px}
  .admin-summary-strip{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));overflow:hidden;border:1px solid rgba(180,210,225,.6);background:#fff;box-shadow:0 1px 2px rgba(0,0,0,.035)}.admin-summary-link{display:flex;min-height:82px;align-items:center;gap:.75rem;border-right:1px solid rgba(180,210,225,.45);border-bottom:1px solid rgba(180,210,225,.45);padding:1rem;text-align:left;transition:.15s}.admin-summary-link:nth-child(2n){border-right:0}.admin-summary-link:nth-last-child(-n+2){border-bottom:0}.admin-summary-link:hover,.admin-summary-link.is-active{background:rgba(216,235,245,.25)}.admin-summary-number{font-family:"Playfair Display",serif;font-size:1.9rem;line-height:1;color:#455A64}.admin-summary-label{font-size:.68rem;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:rgba(69,90,100,.66)}
  .admin-view-tabs{display:flex;overflow:hidden;border:1px solid rgba(180,210,225,.6);background:#fff;padding:.25rem;box-shadow:0 1px 2px rgba(0,0,0,.035)}.admin-view-tab{min-height:44px;min-width:9rem;padding:.65rem 1.15rem;font-size:.72rem;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:rgba(69,90,100,.62);transition:.15s}.admin-view-tab:hover,.admin-view-tab.is-active{background:#455A64;color:#fff}
  .admin-toolbar{display:flex;flex-wrap:wrap;align-items:center;gap:.65rem;border:1px solid rgba(180,210,225,.6);background:#fff;padding:.75rem;box-shadow:0 1px 2px rgba(0,0,0,.035)}.admin-search-wrap{display:flex;min-height:46px;min-width:min(100%,20rem);flex:1;align-items:center;gap:.65rem;border:1px solid rgba(180,210,225,.75);padding:0 .85rem;color:rgba(69,90,100,.55)}.admin-search{min-width:0;flex:1;border:0;background:transparent;font-size:.9rem;color:#455A64;outline:none}.admin-filter-group{display:flex;flex:1 1 auto;flex-wrap:wrap;gap:.5rem}.admin-compact-select{min-height:46px;max-width:14rem;border:1px solid rgba(180,210,225,.75);background:#fff;padding:.55rem 2rem .55rem .8rem;font-size:.8rem;color:#455A64;outline:none}.admin-compact-select:focus{border-color:#3c7f81}
  .admin-table{min-width:100%;border-collapse:separate;border-spacing:0;font-family:Montserrat,sans-serif}.admin-table th{position:sticky;top:0;z-index:3;min-width:10.5rem;border-bottom:1px solid rgba(180,210,225,.7);background:#f8fbfc;padding:.8rem .9rem;text-align:left;font-size:.66rem;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:rgba(69,90,100,.66)}.admin-table th:first-child{left:0;z-index:5;min-width:8rem}.admin-table th:nth-child(2){min-width:11rem}.admin-table td{border-bottom:1px solid rgba(180,210,225,.4);background:#fff;padding:.72rem .9rem;vertical-align:middle;font-size:.83rem;color:#455A64}.admin-table tbody tr:hover td{background:rgba(216,235,245,.16)}.admin-table td:first-child{position:sticky;left:0;z-index:2;background:#fff}.admin-table tbody tr:hover td:first-child{background:#f7fbfc}.admin-sort-header{display:flex;width:100%;align-items:center;justify-content:space-between;gap:.5rem;text-align:left}.admin-sort-indicator{font-size:.8rem;color:#3c7f81}.admin-unit-link{display:block;min-height:42px;text-align:left}.admin-unit-number{font-family:"Playfair Display",serif;font-size:1.25rem;color:#455A64}.admin-unit-meta{margin-top:.15rem;font-size:.69rem;color:rgba(69,90,100,.55)}
  .condition-pill{display:inline-flex;min-height:28px;align-items:center;gap:.4rem;border-radius:999px;padding:.3rem .6rem;font-size:.69rem;font-weight:700;white-space:nowrap}.condition-dot{height:.48rem;width:.48rem;border-radius:999px}.condition-good{background:#e8f5ec;color:#28633b}.condition-good .condition-dot{background:#4f8f5f}.condition-monitor{background:#fff5d9;color:#805f10}.condition-monitor .condition-dot{background:#c28a18}.condition-attention{background:#fdebe7;color:#9e3e29}.condition-attention .condition-dot{background:#c75b39}.condition-unknown{background:#eef1f3;color:#58646a}.condition-unknown .condition-dot{background:#78858c}.condition-na{background:#f5f5f4;color:#73716d}.condition-na .condition-dot{background:#9c9a96}.condition-date{margin-top:.28rem;font-size:.68rem;line-height:1.35;color:rgba(69,90,100,.58)}.condition-cell-button{display:block;min-height:48px;width:100%;text-align:left}
  .admin-mobile-card{border:1px solid rgba(180,210,225,.6);background:#fff;padding:1rem;box-shadow:0 1px 2px rgba(0,0,0,.035)}.admin-mobile-grid{margin-top:.85rem;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.65rem}.admin-mobile-condition{border:1px solid rgba(180,210,225,.42);padding:.65rem;text-align:left}.admin-mobile-condition-label{margin-bottom:.4rem;font-size:.64rem;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:rgba(69,90,100,.55)}
  .admin-drawer{position:fixed;right:0;top:0;z-index:1100;height:100dvh;width:min(100%,43rem);transform:translateX(102%);overflow:hidden;background:#fff;box-shadow:-20px 0 60px rgba(20,35,42,.2);transition:transform .22s ease;visibility:hidden}.admin-drawer.is-open{transform:translateX(0);visibility:visible}.admin-icon-button{display:grid;height:44px;width:44px;flex:none;place-items:center;border:1px solid rgba(69,90,100,.25);background:#fff;font-size:1.5rem;line-height:1;color:#455A64}.admin-condition-editor{border:1px solid rgba(180,210,225,.55);background:#fff;padding:1rem}.admin-condition-editor-head{display:flex;align-items:flex-start;justify-content:space-between;gap:1rem}.admin-condition-title{font-family:"Playfair Display",serif;font-size:1.12rem;color:#455A64}.admin-condition-description{margin-top:.2rem;font-size:.76rem;line-height:1.45;color:rgba(69,90,100,.58)}.admin-condition-fields{margin-top:.9rem;display:grid;gap:.8rem}.admin-condition-fields textarea{min-height:72px}@media(min-width:640px){.admin-condition-fields{grid-template-columns:minmax(10rem,.8fr) minmax(10rem,.8fr) 1.4fr}}
  .admin-history-entry{border-left:3px solid #9AD9D9;background:#f9fbfc;padding:.75rem .85rem}.admin-history-title{font-size:.8rem;font-weight:700;color:#455A64}.admin-history-meta{margin-top:.2rem;font-size:.7rem;color:rgba(69,90,100,.58)}.admin-history-notes{margin-top:.35rem;font-size:.78rem;line-height:1.45;color:rgba(69,90,100,.75)}
  .admin-map-marker{background:transparent;border:0}.admin-map-marker span{display:grid;height:28px;width:28px;place-items:center;border:3px solid #fff;border-radius:999px;background:#455A64;color:#fff;box-shadow:0 3px 12px rgba(0,0,0,.38);font-size:9px;font-weight:700}.admin-map-marker.attention span{background:#c75b39}.admin-map-marker.monitor span{background:#c28a18}.admin-map-marker.good span{background:#4f8f5f}.admin-map-marker.unknown span{background:#78858c}.admin-temp-marker{background:transparent;border:0}.admin-temp-marker span{display:grid;height:34px;width:34px;place-items:center;border:4px solid #fff;border-radius:999px;background:#3c7f81;color:#fff;box-shadow:0 4px 16px rgba(0,0,0,.42);font-size:18px;font-weight:800}
  [data-admin-message][data-type="error"]{border-color:#fecaca;color:#b91c1c}[data-admin-message][data-type="success"]{border-color:#bbf7d0;color:#166534}
  @media(min-width:768px){.admin-summary-strip{grid-template-columns:repeat(4,minmax(0,1fr))}.admin-summary-link{border-bottom:0}.admin-summary-link:nth-child(2n){border-right:1px solid rgba(180,210,225,.45)}.admin-summary-link:last-child{border-right:0}}
  @media(max-width:639px){.admin-filter-group{width:100%}.admin-filter-group label{flex:1 1 calc(50% - .25rem)}.admin-compact-select{width:100%;max-width:none}.admin-toolbar>.admin-button-primary{width:100%}.admin-mobile-grid{grid-template-columns:1fr}.admin-drawer{width:100%}}
  @media(prefers-reduced-motion:reduce){.admin-drawer{transition:none}}
</style>
