---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import { assetUrl } from '../lib/routes.js';
---

<Layout title="Community Resources">
	<PageHero title="Community Resources"
		image="images/pool-beach-view.jpg"
		imagePosition="center 49%">
		<p>Find forms, documents, and community information for renters and homeowners.</p>
	</PageHero>

	<section class="py-16 md:py-24 bg-white">
		<div class="max-w-5xl mx-auto px-4 space-y-14 md:space-y-24">
			
			<!-- Renter Maintenance -->
			<div class="grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-14 items-center">
				<div data-scroll-reveal>
					<h2 class="text-[11px] md:text-xs font-sans font-bold text-beach-sand-dark uppercase tracking-[.22em] mb-6 md:mb-8">Maintenance</h2>
					<h3 class="text-2xl md:text-3xl font-serif text-beach-slate mb-6">Report Amenity Issues</h3>
					<p class="text-beach-slate/90 font-sans text-[0.9375rem] sm:text-base leading-relaxed mb-10">
						If you are a renter at Barrier Dunes and need to report issues concerning our services, rental amenities, 
						or missing items, please contact your <strong>rental contact person</strong> as shown on your rental contract.
					</p>
					<div class="p-6 md:p-8 bg-beach-sky/10 border-l-2 border-beach-sea">
						<p class="text-sm text-beach-slate/90 leading-relaxed">
							Note: The Association does not manage individual rentals directly. Issues within the home must be addressed via your rental agency or owner.
						</p>
					</div>
				</div>
				<div data-scroll-reveal="second" class="aspect-[4/3] md:aspect-square bg-beach-sea/5 overflow-hidden group rounded-sm">
					<img data-reveal-photo
						src={assetUrl('images/optimized/pool-overhead-1200.webp')}
						srcset={`${assetUrl('images/optimized/pool-overhead-720.webp')} 720w, ${assetUrl('images/optimized/pool-overhead-1200.webp')} 1200w, ${assetUrl('images/pool-overhead.webp')} 1600w`}
						sizes="(min-width: 768px) 50vw, 100vw"
						width="1200"
						height="800"
						loading="lazy"
						decoding="async"
						alt="Overhead view of a Barrier Dunes pool and surrounding community"
						class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-1000"
					/>
				</div>
			</div>

			<!-- Clubhouse Rental -->
			<section data-scroll-reveal class="rounded-sm bg-beach-slate p-6 text-white sm:p-9 lg:p-12">
				<p class="mb-3 text-xs font-semibold uppercase tracking-[.14em] text-beach-sea">Private Events</p>
				<h2 class="mb-4 text-3xl md:text-4xl">Reserve the Barrier Dunes Clubhouse</h2>
				<p class="max-w-2xl text-[0.9375rem] leading-relaxed text-white/95 sm:text-base">
					The clubhouse is available for private events, meetings, and community gatherings.
					Review the rental agreement and rules, then request a booking through the Homeowner Portal.
				</p>
				<div class="mt-6 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
					<a href="https://irp-cdn.multiscreensite.com/98c7d9ee/files/uploaded/CLUBHOUSE%20RENTAL%20AGREEMENT%20August%202020.pdf" target="_blank" rel="noopener noreferrer" class="site-button site-button--outline-light">Download Agreement</a>
					<a href="https://irp-cdn.multiscreensite.com/98c7d9ee/files/uploaded/BD%20Rules%20and%20Regulations%20Revised%2010-12-2020.pdf" target="_blank" rel="noopener noreferrer" class="site-button site-button--outline-light">Rules &amp; Regulations</a>
					<a href="https://app.condocontrol.com/login?brand=barrier" target="_blank" rel="noopener noreferrer" class="site-button site-button--light">Access Portal</a>
				</div>
			</section>

			<!-- Lost & Found Integration -->
			<div id="lost-and-found" class="grid grid-cols-1 lg:grid-cols-2 gap-8 md:gap-14 items-start">
				<div class="space-y-10 md:space-y-12">
					<div>
						<h2 class="text-[11px] md:text-xs font-sans font-bold text-beach-sand-dark uppercase tracking-[.22em] mb-6 md:mb-8">Community Assistance</h2>
						<h3 class="text-2xl md:text-3xl font-serif text-beach-slate mb-6">Lost & Found</h3>
						<p class="text-beach-slate/90 font-sans text-[0.9375rem] sm:text-base leading-relaxed mb-6">
							The Barrier Dunes' Lost and Found helps reunite pets and property with their owners. 
							Whether it's a family pet, sunglasses, or beach gear, use our community board to share information.
						</p>
					</div>

					<div data-scroll-reveal class="p-5 md:p-7 bg-beach-sand/5 border border-beach-sand/20 rounded-sm">
						<h4 class="text-[11px] md:text-xs font-sans uppercase tracking-[.16em] text-beach-sand-dark mb-4">Current Notices</h4>
						<div class="flex items-center text-beach-slate/90 italic font-serif py-4 border-t border-beach-sand/10 text-sm">
							<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="mr-3 shrink-0"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
							No active lost or found items.
						</div>
					</div>
				</div>

				<div class="bg-beach-slate p-5 sm:p-8 md:p-10 text-white rounded-sm shadow-md">
					<h4 class="text-xl font-serif mb-6 text-beach-sea">Report an Item</h4>
					<form class="space-y-6">
						<div class="space-y-2">
							<label for="lost-found-name" class="block text-xs tracking-wide text-white/90">Full Name</label>
							<input id="lost-found-name" type="text" class="min-h-11 w-full rounded-sm border border-white/35 bg-white/10 px-3 py-2 text-base focus-visible:outline-beach-sea" placeholder="John Doe" />
						</div>
						<div class="space-y-2">
							<label for="lost-found-description" class="block text-xs tracking-wide text-white/90">Item Description</label>
							<textarea id="lost-found-description" class="min-h-24 w-full rounded-sm border border-white/35 bg-white/10 px-3 py-2 text-base focus-visible:outline-beach-sea" placeholder="Description..."></textarea>
						</div>
						<button type="submit" class="site-button site-button--light w-full">
							Submit Notice
						</button>
					</form>
				</div>
			</div>

		</div>
	</section>

	<!-- HOA CTA -->
	<section class="py-16 md:py-24 bg-white text-center border-t border-beach-sky/10">
		<div data-scroll-reveal class="max-w-2xl mx-auto px-4">
			<h2 class="text-[11px] md:text-xs font-sans font-bold text-beach-sand-dark uppercase tracking-[.22em] mb-8">Homeowner Access</h2>
			<h3 class="text-2xl md:text-3xl font-serif text-beach-slate mb-8 tracking-tight">Already own a property?</h3>
			<p class="text-beach-slate/90 font-sans text-sm mb-12 leading-relaxed">
				Login to your Homeowner Association account panel to view private community updates, manage documents, and submit maintenance requests.
			</p>
			<a href="https://app.condocontrol.com/login?brand=barrier" target="_blank" rel="noopener noreferrer" class="site-button w-full sm:w-auto">
				HOA Login
			</a>
		</div>
	</section>
</Layout>
