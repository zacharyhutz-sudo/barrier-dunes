---
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import { assetUrl } from '../lib/routes.js';

interface Props {
	title: string;
	description?: string;
}

const { title, description = "Barrier Dunes - A private residential complex on St. Joseph Peninsula, Cape San Blas, FL." } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href={assetUrl('favicon.svg')} />
		<meta name="generator" content={Astro.generator} />
		<title>{title} | Barrier Dunes</title>
		<meta name="description" content={description} />
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,100..900;1,100..900&family=Playfair+Display:ital,wght@0,400..900;1,400..900&display=swap" rel="stylesheet">
	</head>
	<body class="public-site bg-beach-ivory font-sans text-beach-slate min-h-screen flex flex-col">
		<Navigation />
		<main class="flex-grow">
			<slot />
		</main>
		<Footer />
	</body>
</html>

<script>
	import '../scripts/scrollReveal.js';
</script>

<style is:global>
	.public-site {
		--beach-sky: 216 229 222;
		--beach-sea: 157 203 191;
		--beach-teal: 39 104 96;
		--beach-sand: 151 132 103;
		--beach-sand-dark: 112 88 59;
		--beach-slate: 44 60 57;
		--public-muted: #51615d;
	}
	html, body {
		font-family: 'Montserrat', sans-serif;
		-webkit-tap-highlight-color: transparent;
	}
	html {
		scroll-behavior: smooth;
		scroll-padding-top: 5.5rem;
	}
	body {
		overflow-x: clip;
	}
	h1, h2, h3, h4, h5, h6 {
		font-family: 'Playfair Display', serif;
	}


	.site-button {
		display: inline-flex;
		min-height: 2.75rem;
		align-items: center;
		justify-content: center;
		border: 1px solid transparent;
		border-radius: .125rem;
		padding: .65rem 1.1rem;
		background: rgb(var(--beach-slate));
		color: white;
		font-size: .875rem;
		font-weight: 600;
		line-height: 1.35;
		text-align: center;
		transition: background-color .2s, border-color .2s, color .2s;
	}
	.site-button:hover {
		background: rgb(var(--beach-teal));
		color: white;
	}
	.site-button--outline {
		background: transparent;
		border-color: rgb(var(--beach-slate) / 55%);
		color: rgb(var(--beach-slate));
	}
	.site-button--outline:hover { border-color: rgb(var(--beach-teal)); }
	.site-button--light {
		background: white;
		color: rgb(var(--beach-slate));
	}
	.site-button--light:hover {
		background: rgb(var(--beach-sky));
		color: rgb(var(--beach-slate));
	}
	.site-button--outline-light {
		background: transparent;
		border-color: rgb(255 255 255 / 65%);
	}
	.site-button--outline-light:hover {
		background: white;
		border-color: white;
		color: rgb(var(--beach-slate));
	}
	.site-text-link {
		display: inline-flex;
		min-height: 2.75rem;
		align-items: center;
		color: rgb(var(--beach-slate));
		font-size: .875rem;
		font-weight: 600;
	}

	[data-scroll-reveal].is-revealing:not(:focus-within) {
		animation: scroll-reveal 400ms ease-out both;
	}

	@media (min-width: 768px) {
		[data-scroll-reveal="second"].is-revealing { animation-delay: 55ms; }
		[data-scroll-reveal="third"].is-revealing { animation-delay: 90ms; }
	}

	@keyframes scroll-reveal {
		from { opacity: .72; transform: translateY(8px); }
		to { opacity: 1; transform: translateY(0); }
	}

	a:focus-visible, button:focus-visible, input:focus-visible, textarea:focus-visible {
		outline: 2px solid rgb(var(--beach-teal));
		outline-offset: 3px;
	}

	.site-button:is(.site-button--light, .site-button--outline-light):focus-visible {
		outline-color: white;
	}
	@media (prefers-reduced-motion: reduce) {
		html { scroll-behavior: auto; }
		[data-scroll-reveal].is-revealing { animation: none !important; }
		*, *::before, *::after {
			animation-duration: 0.01ms !important;
			animation-iteration-count: 1 !important;
			transition-duration: 0.01ms !important;
		}
	}

</style>
