---
import { routes } from '../lib/routes.js';

const navLinks = [
	{ text: 'Home', href: routes.home },
	{ text: 'Condos', href: routes.condos },
	{ text: 'Rules & Regulations', href: routes.rules },
	{ text: 'Local Attractions', href: routes.attractions },
	{ text: 'Area & Emergency Services', href: routes.areaServices },
	{ text: 'Community Resources', href: routes.communityResources },
];
---

<header class="bg-white border-b border-beach-sky/30 sticky top-0 z-50">
	<nav class="mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between" aria-label="Primary navigation">
		<div class="flex-shrink-0">
			<a href={routes.home} class="flex items-center group">
				<div class="h-12 w-12 bg-beach-sea flex items-center justify-center rounded-full mr-3 group-hover:bg-beach-teal transition-colors">
					<span class="text-beach-slate group-hover:text-white font-serif text-xl italic transition-colors">BD</span>
				</div>
				<div>
					<span class="text-base sm:text-lg lg:text-xl font-serif text-beach-slate uppercase tracking-wider sm:tracking-widest leading-none block">Barrier Dunes</span>
					<p class="text-[11px] font-sans text-beach-sand-dark uppercase tracking-[.14em] sm:tracking-[.18em] mt-1 whitespace-nowrap">St. Joseph Peninsula</p>
				</div>
			</a>
		</div>

		<div class="hidden xl:flex items-center space-x-4 2xl:space-x-6">
			{navLinks.map((link) => (
				<a href={link.href} class="text-[11px] 2xl:text-xs font-sans text-beach-slate hover:text-beach-teal transition-colors uppercase tracking-[.11em] whitespace-nowrap">
					{link.text}
				</a>
			))}
			<a href="https://app.condocontrol.com/login?brand=barrier" target="_blank" rel="noopener noreferrer" class="bg-beach-slate text-white px-4 2xl:px-6 py-2.5 rounded-sm text-[11px] 2xl:text-xs font-sans uppercase tracking-widest hover:bg-beach-teal transition-colors whitespace-nowrap">
				HOA Login
			</a>
		</div>

		<!-- Mobile Menu Button (Tablet & Mobile) -->
		<div class="xl:hidden">
			<button id="mobile-menu-button" class="text-beach-slate p-2 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-beach-teal focus-visible:ring-offset-2" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-menu">
				<svg id="menu-icon" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg>
				<svg id="close-icon" class="hidden" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
			</button>
		</div>
	</nav>

	<!-- Mobile Menu Sidebar -->
	<div id="mobile-menu" class="fixed inset-0 z-[100] transform translate-x-full transition-transform duration-500 ease-in-out xl:hidden invisible overflow-hidden" aria-hidden="true">
		<!-- Backdrop -->
		<div id="mobile-menu-backdrop" class="absolute inset-0 bg-beach-slate/60 backdrop-blur-md opacity-0 transition-opacity duration-500"></div>
		
		<!-- Sidebar -->
		<div class="absolute right-0 top-0 h-full w-[88%] max-w-sm bg-white shadow-[-20px_0_60px_-15px_rgba(0,0,0,0.3)] p-7 sm:p-8 overflow-y-auto flex flex-col justify-between">
			<div class="flex flex-col space-y-2 mt-12">
				{navLinks.map((link, i) => (
					<a 
						href={link.href} 
						class="mobile-nav-link opacity-0 translate-x-12 transition-all duration-500 text-[1.05rem] font-serif text-beach-slate hover:text-beach-sand-dark uppercase tracking-[.08em] border-b border-beach-sky/20 py-3.5 flex items-center justify-between gap-4"
						style={`transition-delay: ${100 + i * 40}ms`}
					>
						<span>{link.text}</span>
						<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-beach-sand-dark/70 shrink-0" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
					</a>
				))}
				<a 
					href="https://app.condocontrol.com/login?brand=barrier" 
					target="_blank"
					rel="noopener noreferrer"
					class="mobile-nav-link opacity-0 translate-x-12 transition-all duration-500 bg-beach-slate text-white px-8 py-4 rounded-sm text-xs font-sans uppercase tracking-[.2em] text-center hover:bg-beach-teal transition-colors shadow-lg mt-6"
					style={`transition-delay: ${100 + navLinks.length * 40}ms`}
				>
					HOA Login
				</a>
			</div>

			<div class="mt-8 pb-4 text-center">
				<p class="text-[11px] font-sans text-beach-sand-dark uppercase tracking-[.2em] leading-relaxed">Established on the St. Joseph Peninsula</p>
			</div>
		</div>
	</div>
</header>

<script>
	const menuButton = document.getElementById('mobile-menu-button');
	const mobileMenu = document.getElementById('mobile-menu');
	const backdrop = document.getElementById('mobile-menu-backdrop');
	const menuIcon = document.getElementById('menu-icon');
	const closeIcon = document.getElementById('close-icon');
	const mobileNavLinks = document.querySelectorAll('.mobile-nav-link');

	function toggleMenu() {
		const isOpen = mobileMenu?.classList.contains('translate-x-0');
		
		if (isOpen) {
			mobileMenu?.classList.add('translate-x-full');
			mobileMenu?.classList.remove('translate-x-0');
			backdrop?.classList.add('opacity-0');
			backdrop?.classList.remove('opacity-100');
			
			mobileNavLinks.forEach(link => {
				link.classList.add('opacity-0', 'translate-x-12');
				link.classList.remove('opacity-100', 'translate-x-0');
			});

			setTimeout(() => {
				mobileMenu?.classList.add('invisible');
			}, 500);

			menuIcon?.classList.remove('hidden');
			closeIcon?.classList.add('hidden');
			menuButton?.setAttribute('aria-expanded', 'false');
			menuButton?.setAttribute('aria-label', 'Open menu');
			mobileMenu?.setAttribute('aria-hidden', 'true');
			document.body.style.overflow = 'auto';
		} else {
			mobileMenu?.classList.remove('invisible');
			mobileMenu?.classList.remove('translate-x-full');
			mobileMenu?.classList.add('translate-x-0');
			backdrop?.classList.remove('opacity-0');
			backdrop?.classList.add('opacity-100');
			
			mobileNavLinks.forEach(link => {
				link.classList.remove('opacity-0', 'translate-x-12');
				link.classList.add('opacity-100', 'translate-x-0');
			});

			menuIcon?.classList.add('hidden');
			closeIcon?.classList.remove('hidden');
			menuButton?.setAttribute('aria-expanded', 'true');
			menuButton?.setAttribute('aria-label', 'Close menu');
			mobileMenu?.setAttribute('aria-hidden', 'false');
			document.body.style.overflow = 'hidden';
		}
	}

	menuButton?.addEventListener('click', toggleMenu);
	backdrop?.addEventListener('click', toggleMenu);

	mobileNavLinks.forEach(link => {
		link.addEventListener('click', () => {
			toggleMenu();
		});
	});
</script>
