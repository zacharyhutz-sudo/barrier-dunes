---
import { routes } from '../lib/routes.js';

const normalizePath = (path) => path.replace(/\/index\.html$/, '/').replace(/\/$/, '');
const currentPath = normalizePath(Astro.url.pathname);
const navLinks = [
	{ text: 'Home', href: routes.home },
	{ text: 'Condos', href: routes.condos },
	{ text: 'Rules & Regulations', href: routes.rules },
	{ text: 'Local Attractions', href: routes.attractions },
	{ text: 'Area & Emergency Services', href: routes.areaServices },
	{ text: 'Community Resources', href: routes.communityResources },
].map((link) => ({ ...link, current: normalizePath(link.href) === currentPath }));
---

<header class="bg-beach-ivory border-b border-beach-sky/30 sticky top-0 z-50">
	<nav class="mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between" aria-label="Primary navigation">
		<div class="flex-shrink-0">
			<a href={routes.home} class="flex items-center group">
				<div class="h-12 w-12 bg-beach-sea flex items-center justify-center rounded-full mr-3 group-hover:bg-beach-teal transition-colors">
					<span class="text-beach-slate group-hover:text-white font-serif text-xl italic transition-colors">BD</span>
				</div>
				<div>
					<span class="text-base sm:text-lg lg:text-xl font-serif text-beach-slate uppercase tracking-wider sm:tracking-widest leading-none block">Barrier Dunes</span>
					<p class="text-[11px] font-sans text-beach-sand-dark uppercase tracking-[.14em] sm:tracking-[.18em] mt-1 whitespace-nowrap">St. Joseph Peninsula</p>
				</div>
			</a>
		</div>

		<div class="hidden xl:flex items-center space-x-4 2xl:space-x-6">
			{navLinks.map((link) => (
				<a href={link.href} aria-current={link.current ? 'page' : undefined} class="text-[11px] 2xl:text-xs font-sans text-beach-slate hover:text-beach-teal transition-colors uppercase tracking-[.11em] whitespace-nowrap">
					{link.text}
				</a>
			))}
			<a href="https://app.condocontrol.com/login?brand=barrier" target="_blank" rel="noopener noreferrer" class="bg-beach-slate text-white px-4 2xl:px-6 py-2.5 rounded-sm text-[11px] 2xl:text-xs font-sans uppercase tracking-widest hover:bg-beach-teal transition-colors whitespace-nowrap">
				HOA Login
			</a>
		</div>

			<div class="xl:hidden">
			<button id="mobile-menu-button" type="button" class="grid size-11 place-items-center rounded-sm text-beach-slate" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-menu" aria-haspopup="dialog">
				<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg>
			</button>
		</div>
	</nav>

	<dialog id="mobile-menu" aria-label="Site menu" class="fixed inset-0 m-0 h-full max-h-none w-full max-w-none overflow-hidden bg-transparent text-beach-slate">
		<div class="mobile-menu-panel ml-auto flex h-full w-[88%] max-w-sm flex-col overflow-y-auto overscroll-contain bg-white p-5 shadow-xl sm:p-8">
			<button id="mobile-menu-close" type="button" class="mb-3 grid size-11 shrink-0 place-items-center self-end rounded-sm text-beach-slate" aria-label="Close menu" autofocus>
				<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18"/></svg>
			</button>
			<nav aria-label="Mobile navigation" class="flex flex-col">
				{navLinks.map((link, index) => (
					<a href={link.href} aria-current={link.current ? 'page' : undefined}
						class="mobile-menu-link flex min-h-12 items-center justify-between gap-3 border-b border-beach-sky px-2 py-3 font-serif text-base uppercase tracking-[.08em] hover:text-beach-teal"
						style={`--menu-link-delay: ${Math.min(index * 12, 60)}ms`}>
						<span>{link.text}</span>
						<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="shrink-0 text-beach-sand-dark" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
					</a>
				))}
				<a href="https://app.condocontrol.com/login?brand=barrier" target="_blank" rel="noopener noreferrer" class="mt-5 rounded-sm bg-beach-slate px-6 py-4 text-center text-xs uppercase tracking-[.2em] text-white transition-colors hover:bg-beach-teal">
					HOA Login
				</a>
			</nav>
			<p class="mt-auto pt-7 text-center text-[11px] uppercase tracking-[.16em] text-beach-sand-dark">Established on the St. Joseph Peninsula</p>
		</div>
	</dialog>
</header>

<style>
	a[aria-current="page"] {
		color: rgb(var(--beach-teal));
		text-decoration: underline;
		text-decoration-thickness: 2px;
		text-underline-offset: .4em;
	}
	.mobile-menu-link[aria-current="page"] { background-color: #edf3ed; }

	#mobile-menu::backdrop { background: rgb(32 52 62 / 50%); }
	:global(body:has(#mobile-menu[open])) { overflow: hidden; }

	@media (prefers-reduced-motion: no-preference) {
		#mobile-menu[open] .mobile-menu-panel { animation: menu-slide 240ms ease-out; }
		#mobile-menu[open] .mobile-menu-link {
			animation: menu-link 170ms ease-out var(--menu-link-delay) both;
		}
	}

	@keyframes menu-slide {
		from { transform: translateX(100%); }
		to { transform: translateX(0); }
	}

	@keyframes menu-link {
		from { opacity: .65; transform: translateX(6px); }
		to { opacity: 1; transform: translateX(0); }
	}
</style>

<script>
	const menuButton = document.querySelector<HTMLButtonElement>('#mobile-menu-button');
	const menu = document.querySelector<HTMLDialogElement>('#mobile-menu');
	const closeButton = document.querySelector<HTMLButtonElement>('#mobile-menu-close');

	if (menuButton && menu && closeButton) {
		menuButton.addEventListener('click', () => {
			menu.showModal();
			menuButton.setAttribute('aria-expanded', 'true');
		});

		closeButton.addEventListener('click', () => menu.close());

		menu.addEventListener('click', (event) => {
			if (event.target === menu || (event.target instanceof Element && event.target.closest('a'))) {
				menu.close();
			}
		});

		menu.addEventListener('close', () => {
			menuButton.setAttribute('aria-expanded', String(menu.open));
		});

		window.matchMedia('(min-width: 1280px)').addEventListener('change', ({ matches }) => {
			if (matches && menu.open) menu.close();
		});
	}
</script>
