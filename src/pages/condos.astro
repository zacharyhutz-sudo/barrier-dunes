---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import { assetUrl } from '../lib/routes.js';

const condos = [
	{
		id: "sherri",
		name: "There's Always Time for the Sea",
		image: "time-for-the-sea",
		imageAlt: "Front of the vacation rental with raised balconies and a palm tree",
		beds: "2 Bedrooms (1 King, 2 Queens)",
		baths: "2 Bathrooms",
		features: [
			"Steps from the beach boardwalk",
			"Fully stocked gourmet kitchen",
			"Private balconies for each bedroom",
			"Located near tennis courts and pool"
		],
		link: "https://theresalwaystimeforthesea.com",
		coordinates: [29.74901, -85.39838]
	},
	{
		id: "dune-reel-good",
		name: "Dune Reel Good",
		image: "dune-reel-good",
		imageAlt: "Gulf view between the townhomes at Dune Reel Good",
		beds: "2 Bedrooms (King, Queen)",
		baths: "2 Bathrooms",
		features: [
			"Tesla Charger in Carport",
			"200 steps to the sand",
			"Two large Gulf Side Decks",
			"Beach gear included with stay",
			"Enclosed Hot/Cold Outdoor Shower"
		],
		link: "https://www.thecapeescape.com/cape-san-blas-vacation-rentals/dune-reel-good/",
		coordinates: [29.74788, -85.39801]
	}
];
---

<Layout page="condos">
	<!-- Title Section -->
	<PageHero title="Condos at Barrier Dunes"
		eyebrow="Stay at Barrier Dunes"
		image="images/community-drone.webp"
		imagePosition="center 52%">
		<p>Browse privately owned vacation rentals and check availability with each owner.</p>
		<a href="#community-map" class="site-text-link mt-3 underline underline-offset-4">View community map</a>
	</PageHero>

	<section class="py-12 md:py-20 bg-beach-ivory" aria-label="Vacation rentals">
		<div class="max-w-7xl mx-auto px-4 sm:px-6">
			<div class="space-y-8 md:space-y-12">
				{condos.map((condo) => (
					<article data-scroll-reveal id={condo.id} class="grid md:grid-cols-[minmax(0,1.1fr)_minmax(0,1fr)] bg-white border border-beach-sand/30 rounded-sm">
						<!-- Image Left -->
						<div class="relative aspect-[4/3] md:aspect-auto md:min-h-96 overflow-hidden rounded-t-sm md:rounded-r-none md:rounded-l-sm bg-beach-sky">
							<img data-reveal-photo
								src={assetUrl(`images/optimized/${condo.image}-1000.webp`)}
								srcset={`${assetUrl(`images/optimized/${condo.image}-480.webp`)} 480w, ${assetUrl(`images/optimized/${condo.image}-1000.webp`)} 1000w`}
								sizes="(min-width: 1280px) 650px, (min-width: 768px) 51vw, 100vw"
								width="1000" height="750" alt={condo.imageAlt} loading="lazy" decoding="async"
								class="absolute inset-0 h-full w-full object-cover" />
						</div>
						
						<!-- Content Right -->
						<div class="min-w-0 p-6 sm:p-8 lg:p-12 flex flex-col justify-center">
							<h2 class="text-[1.75rem] md:text-3xl lg:text-[2.625rem] font-serif text-beach-slate mb-4 sm:mb-5 leading-tight tracking-tight">{condo.name}</h2>
							
							<div class="flex flex-wrap items-center gap-x-5 gap-y-2 mb-5 sm:mb-7 text-sm font-sans text-beach-sand-dark font-semibold">
								<span class="flex items-center">
									<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mr-2"><path d="M2 20v-8a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v8"/><path d="M4 10V6a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v4"/><path d="M12 4v16"/><path d="M2 17h20"/></svg>
									{condo.beds}
								</span>
								<span class="flex items-center">
									<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mr-2"><path d="M9 6 6.5 3.5a1.5 1.5 0 0 0-2.12 0 1.5 1.5 0 0 0 0 2.12L7 8.5"/><rect x="2" y="14" width="20" height="8" rx="2"/><path d="M5 14v-2a3 3 0 0 1 3-3h8a3 3 0 0 1 3 3v2"/></svg>
									{condo.baths}
								</span>
							</div>

							<ul class="space-y-2 mb-6 sm:mb-8 border-t border-beach-sand/25 pt-5">
								{condo.features.map((feature) => (
									<li class="flex items-baseline text-sm sm:text-[0.9375rem] text-beach-slate/90 font-sans">
										<span class="w-1.5 h-1.5 rounded-full bg-beach-sea mr-3 shrink-0"></span>
										{feature}
									</li>
								))}
							</ul>

							<a href={condo.link} aria-label={`View availability for ${condo.name}`} target="_blank" rel="sponsored noopener noreferrer" class="site-button w-full sm:w-fit">
								View Availability
							</a>
						</div>
					</article>
				))}
			</div>

			<!-- Renter Notice -->
			<div class="mt-16 md:mt-24 p-8 md:p-12 bg-white border border-beach-sand/30 text-center rounded-sm">
				<h3 class="text-xl font-serif text-beach-slate mb-4">Want to list your condo?</h3>
				<p class="text-beach-slate/90 font-sans text-sm sm:text-base leading-relaxed mb-6 max-w-xl mx-auto">
					Email Hutzell Creative Co. to add your Barrier Dunes rental to this directory.
				</p>
				<a href="mailto:hutzellcreativeco@gmail.com?subject=Barrier%20Dunes%20condo%20listing" class="site-button site-button--outline w-full sm:w-auto">
					List your condo
				</a>
			</div>
		</div>
	</section>
	<h2 id="community-map" tabindex="-1" class="mx-auto w-full max-w-7xl px-4 pb-5 pt-8 text-3xl sm:px-6">Community map</h2>
	<!-- Map Section -->
	<section class="relative h-[400px] md:h-[600px] w-full bg-beach-slate overflow-hidden border-y border-beach-sky/20">
		<div id="condo-map" class="h-full w-full z-10"></div>
		
		<!-- Mobile Interaction Overlay -->
		<button id="map-interaction-overlay" type="button" class="absolute inset-0 w-full z-[15] bg-beach-slate/10 flex items-center justify-center cursor-pointer group md:hidden">
			<span class="bg-white/90 backdrop-blur-sm px-6 py-3 border border-beach-sky/20 shadow-lg text-[11px] font-sans uppercase tracking-[.16em] text-beach-slate">Tap to Explore Map</span>
		</button>

		<!-- Map Legend -->
		<div class="absolute bottom-6 right-6 z-20 hidden md:block">
			<div class="bg-white/90 backdrop-blur-sm p-4 border border-beach-sky/20 shadow-lg space-y-2">
				<div class="flex items-center text-[11px] md:text-xs font-sans uppercase tracking-[.12em] text-beach-slate">
					<span class="w-3 h-3 bg-beach-sea rounded-full mr-3 shadow-sm"></span> Available Condos
				</div>
				<div class="flex items-center text-[11px] md:text-xs font-sans uppercase tracking-[.12em] text-beach-slate">
					<span class="w-3 h-3 bg-beach-sand rounded-full mr-3 shadow-sm"></span> Amenities
				</div>
			</div>
		</div>
	</section>
</Layout>

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
<script is:inline src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>

<script is:inline define:vars={{ condos }}>
	// Wait for Leaflet to be ready
	window.addEventListener('load', () => {
		const isMobile = window.innerWidth < 768;
		
		const map = L.map('condo-map', {
			center: [29.7485, -85.3975],
			zoom: 17,
			scrollWheelZoom: false,
			dragging: !isMobile,
			tap: !isMobile
		});

		// Add ESRI Satellite Imagery with a custom class for filtering
		L.tileLayer('https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}', {
			attribution: 'Tiles &copy; Esri &mdash; Source: Esri, i-cubed, USDA, USGS, AEX, GeoEye, Getmapping, Aerogrid, IGN, IGP, UPR-EGP, and the GIS User Community',
			className: 'beachy-map-tiles'
		}).addTo(map);

		// Handle Mobile Interaction Overlay
		const overlay = document.getElementById('map-interaction-overlay');
		if (overlay) {
			overlay.addEventListener('click', () => {
				overlay.style.display = 'none';
				map.dragging.enable();
				if (map.tap) map.tap.enable();
			});
		}

		// Custom Condo Icon
		const condoIcon = L.divIcon({
			className: 'custom-div-icon',
			html: `<div style="background-color: #008080; width: 14px; height: 14px; border: 2.5px solid #ffffff; border-radius: 50%; box-shadow: 0 2px 8px rgba(0,0,0,0.5), 0 0 0 2px rgba(0,128,128,0.2);"></div>`,
			iconSize: [14, 14],
			iconAnchor: [7, 7]
		});

		// Add markers for each condo
		condos.forEach(condo => {
			if (condo.coordinates) {
				const marker = L.marker(condo.coordinates, { icon: condoIcon }).addTo(map);
				marker.bindPopup(`
					<div style="font-family: serif; text-align: center; padding: 5px;">
						<p style="margin: 0 0 8px 0; text-transform: uppercase; letter-spacing: 1px; font-size: 11px; font-weight: bold; color: #333;">${condo.name}</p>
						<a href="#${condo.id}" style="color: #008080; text-decoration: none; font-size: 10px; text-transform: uppercase; font-weight: bold;">View Details</a>
					</div>
				`);
			}
		});

		// Add Amenities markers
		const amenityIcon = L.divIcon({
			className: 'custom-div-icon',
			html: `<div style="background-color: #ff9f43; width: 10px; height: 10px; border: 2px solid white; border-radius: 50%; box-shadow: 0 2px 6px rgba(0,0,0,0.4);"></div>`,
			iconSize: [10, 10],
			iconAnchor: [5, 5]
		});

		const amenities = [
			{ name: "Gated Entrance", coords: [29.74821, -85.39611] },
			{ name: "Beachfront Pool", coords: [29.74852, -85.39932] },
			{ name: "Interior Pool", coords: [29.74931, -85.39780] },
			{ name: "Tennis Courts", coords: [29.74927, -85.39813] },
			{ name: "Playground", coords: [29.74882, -85.39650] }
		];

		amenities.forEach(amenity => {
			L.marker(amenity.coords, { icon: amenityIcon }).addTo(map)
				.bindTooltip(amenity.name, { permanent: false, direction: 'top' });
		});
	});
</script>

<style is:global>
	/* Balanced Aerial Color Grade */
	.beachy-map-tiles {
		/* 
		   Brightness 1.1: Clean, airy feel
		   Saturate 0.85: Restores natural greens to the vegetation
		   Contrast 1.05: Sharp but natural
		   Hue-rotate -10deg: Neutralizes the heaviest yellows without killing the green channel
		*/
		filter: brightness(1.1) saturate(0.85) contrast(1.05) hue-rotate(-10deg) !important;
	}

	.leaflet-popup-content-wrapper {
		border-radius: 0;
		padding: 5px;
	}
	.leaflet-popup-tip {
		display: none;
	}
	.leaflet-container {
		font-family: inherit;
	}
</style>
