---
import { routes } from '../lib/routes.js';

const navLinks = [
	{ text: 'Home', href: routes.home },
	{ text: 'Condos', href: routes.condos },
	{ text: 'Rules & Regulations', href: routes.rules },
	{ text: 'Local Attractions', href: routes.attractions },
	{ text: 'Area & Emergency Services', href: routes.areaServices },
	{ text: 'Community Resources', href: routes.communityResources },
];
---

<footer class="bg-beach-sky text-beach-slate py-9 md:py-12">
	<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8 lg:gap-10">
		<!-- Branding & Description -->
		<div class="sm:col-span-2 text-center sm:text-left">
			<h2 class="text-xl sm:text-2xl md:text-3xl font-serif mb-3 tracking-tight leading-tight">Barrier Dunes</h2>
			<p class="max-w-md mx-auto md:mx-0 text-beach-slate/85 leading-relaxed font-sans text-sm">
				A private residential complex on the St. Joseph Peninsula, Cape San Blas, Florida. 
				Experience sugar-white sand dunes, emerald green waters, and a peaceful environment to live and play.
			</p>
		</div>

		<!-- Links -->
		<div class="min-w-0 text-center sm:text-left">
			<h3 class="text-xs font-sans font-bold uppercase tracking-widest mb-4 sm:mb-5 border-b border-beach-slate/10 pb-4 md:border-0 md:pb-0">Explore</h3>
			<ul class="space-y-1">
				{navLinks.map((link) => (
					<li><a href={link.href} class="inline-flex min-h-10 items-center text-sm font-sans hover:text-beach-teal transition-colors py-1">{link.text}</a></li>
				))}
			</ul>
		</div>

		<!-- Contact & Legal -->
		<div class="min-w-0 text-center sm:text-left">
			<h3 class="text-xs font-sans font-bold uppercase tracking-widest mb-4 sm:mb-5 border-b border-beach-slate/10 pb-4 md:border-0 md:pb-0">Contact</h3>
			<div class="space-y-4 text-sm font-sans">
				<p class="font-serif italic">Burg Management, Inc.</p>
				<p>St. Joseph Peninsula, <br class="md:hidden" /> Cape San Blas, FL 32456</p>
				<p><a href="mailto:Paula@burgmanagement.com" class="hover:text-beach-teal transition-colors underline underline-offset-4 [overflow-wrap:anywhere]">Email Burg Management</a></p>
				<p><a href="mailto:cheryl@rapacpas.com" class="hover:text-beach-teal transition-colors underline underline-offset-4 [overflow-wrap:anywhere]">Email Association Records</a></p>
			</div>
		</div>
	</div>

	<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mt-7 pt-5 md:mt-8 border-t border-beach-slate/15 text-center">
		<p class="text-xs text-beach-slate/85">
			&copy; {new Date().getFullYear()} Barrier Dunes Community Association. All rights reserved.
		</p>
		<p class="mt-1 text-xs text-beach-slate/80">
			Developed by Hutzell Creative Co.
		</p>
		<a href={routes.adminLogin} class="mt-3 inline-flex min-h-11 items-center gap-2 text-xs font-medium text-beach-slate/85 transition hover:text-beach-slate" aria-label="Board administration login">
			Board Administration
		</a>
	</div>
</footer>
